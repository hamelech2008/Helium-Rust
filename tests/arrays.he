function main() -> Integer
{
    dec size = 5;
    dec numbers = [Integer, size];

    numbers[0] = 10;
    numbers[1] = 20;
    numbers[2] = 30;
    numbers[3] = 40;
    numbers[4] = 50;

    dec a = numbers[0];
    dec b = numbers[1];

    numbers[2] = numbers[0] + numbers[1];

    dec c = numbers[2];

    return a + b + c;
}